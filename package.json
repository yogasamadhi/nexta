{
  "name": "personal-execution-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @workspace/mobile run start",
    "ios": "pnpm --filter @workspace/mobile run ios",
    "android": "pnpm --filter @workspace/mobile run android",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsx scripts/check-types.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:architecture": "tsx scripts/check-architecture.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "release:check": "tsx scripts/check-release.ts",
    "release:gate": "pnpm run check && pnpm run test:e2e",
    "build:check": "tsx scripts/check-mobile-bundle.ts",
    "build:preview:ios": "pnpm --filter @workspace/mobile run build:preview:ios",
    "build:preview:android": "pnpm --filter @workspace/mobile run build:preview:android",
    "build:ios": "pnpm --filter @workspace/mobile run build:ios",
    "build:android": "pnpm --filter @workspace/mobile run build:android",
    "submit:ios": "pnpm --filter @workspace/mobile run submit:ios",
    "submit:android": "pnpm --filter @workspace/mobile run submit:android",
    "test:e2e": "tsx scripts/check-device-e2e.ts",
    "bench:scheduler": "tsx scripts/benchmark-scheduler.ts",
    "check": "tsx scripts/check.ts",
    "test:ui": "tsx scripts/test-ui.ts",
    "test:hermes": "tsx scripts/test-hermes.ts",
    "server:dev": "make -C server run",
    "server:check": "make -C server check",
    "server:generate": "make -C server generate",
    "server:test:integration": "make -C server integration",
    "server:test:sync": "tsx scripts/test-cloud-local.ts",
    "server:codegen:check": "tsx scripts/check-server-codegen.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@workspace/agent-core": "workspace:*",
    "@workspace/agent-tools": "workspace:*",
    "@workspace/application": "workspace:*",
    "@workspace/database": "workspace:*",
    "@workspace/domain": "workspace:*",
    "@workspace/model-runtime": "workspace:*",
    "@workspace/scheduler-core": "workspace:*",
    "@workspace/user-model": "workspace:*",
    "eas-cli": "24.3.0",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.6.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "zod": "4.6.2"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
