{
  "name": "personal-execution-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/mobile start",
    "ios": "bun run --cwd apps/mobile ios",
    "android": "bun run --cwd apps/mobile android",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "bun scripts/check-types.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:architecture": "bun scripts/check-architecture.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "docs:check": "bun scripts/check-docs.ts",
    "release:check": "bun scripts/check-release.ts",
    "release:gate": "bun run check && bun run test:e2e",
    "build:check": "bun scripts/check-mobile-bundle.ts",
    "build:preview:ios": "bun run --cwd apps/mobile build:preview:ios",
    "build:preview:android": "bun run --cwd apps/mobile build:preview:android",
    "build:ios": "bun run --cwd apps/mobile build:ios",
    "build:android": "bun run --cwd apps/mobile build:android",
    "submit:ios": "bun run --cwd apps/mobile submit:ios",
    "submit:android": "bun run --cwd apps/mobile submit:android",
    "test:e2e": "bun scripts/check-device-e2e.ts",
    "bench:scheduler": "bun scripts/benchmark-scheduler.ts",
    "check": "bun scripts/check.ts",
    "test:ui": "bun scripts/test-ui.ts",
    "test:hermes": "bun scripts/test-hermes.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "@workspace/application": "workspace:*",
    "eas-cli": "24.3.0",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "zod": "4.6.2"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
