# Local-only development database provided by compose.yaml.
DATABASE_URL=postgres://execution_dev:local-development-only@127.0.0.1:5548/execution_dev?sslmode=disable
HTTP_ADDR=127.0.0.1:8000
GRPC_ADDR=127.0.0.1:9000
# Replace with a random secret (at least 32 bytes); never commit a real deployment secret.
ACCESS_TOKEN_SECRET=local-development-signing-key-32-bytes-only
# Internal development only. The default is false.
ALLOW_UNVERIFIED_REGISTRATION=true
